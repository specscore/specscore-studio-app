{
  "name": "app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/app/src",
  "tags": [],
  "targets": {
    "build-app": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": {
          "base": "dist/apps/app/browser/app",
          "browser": ""
        },
        "browser": "apps/app/src/main.ts",
        "tsConfig": "apps/app/tsconfig.app.json",
        "baseHref": "/app/",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/app/public"
          }
        ],
        "styles": [
          "apps/app/src/tailwind.css",
          "apps/app/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/app/src/environments/environment.ts",
              "with": "apps/app/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.5mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "25kb",
              "maximumError": "40kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/app/browser"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/cloudflare/_headers",
        "{workspaceRoot}/tools/mount-app-shell.mjs"
      ],
      "options": {
        "commands": [
          "nx run app:build-app:production",
          "node tools/mount-app-shell.mjs"
        ],
        "parallel": false
      },
      "configurations": {
        "production": {
          "commands": [
            "nx run app:build-app:production",
            "node tools/mount-app-shell.mjs"
          ]
        },
        "development": {
          "commands": [
            "nx run app:build-app:development",
            "node tools/mount-app-shell.mjs"
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "app:build-app:production"
        },
        "development": {
          "buildTarget": "app:build-app:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "setupFiles": [
          "apps/app/src/test-setup.ts"
        ]
      }
    },
    "serve-static": {
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/mount-app-shell.mjs && pnpm exec serve dist/apps/app/browser --single --listen 4200"
      }
    }
  }
}
